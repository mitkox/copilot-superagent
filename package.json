{
  "name": "copilot-superagent",
  "version": "0.4.0",
  "private": true,
  "license": "MIT",
  "description": "Copilot-only VS Code repository agents and shared ticket engine.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "install:extension": "npm --prefix vscode ci --ignore-scripts",
    "build": "npm --prefix vscode run build",
    "typecheck": "npm --prefix vscode run typecheck",
    "test": "npm --prefix vscode run test",
    "check": "npm --prefix vscode run check",
    "package": "npm --prefix vscode run package",
    "audit:production": "npm --prefix vscode run audit:production",
    "test:offline": "npm --prefix vscode run test:offline",
    "test:editor": "npm --prefix vscode run test:editor"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mitkox/copilot-superagent.git"
  },
  "homepage": "https://github.com/mitkox/copilot-superagent#readme",
  "bugs": {
    "url": "https://github.com/mitkox/copilot-superagent/issues"
  }
}
